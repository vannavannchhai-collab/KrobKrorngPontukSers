{
  "name": "krobkrorng-pontuk-sers",
  "private": true,
  "version": "1.0.0",
  "description": "ប្រព័ន្ធគ្រប់គ្រងពិន្ទុសិស្ស — Student Grade Management System",
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "serve": "npm run build && tsx server/index.ts",
