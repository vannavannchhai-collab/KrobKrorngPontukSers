# ───────────────────────────────────────────────────────────────
#  ប្រព័ន្ធគ្រប់គ្រងពិន្ទុសិស្ស — Environment variables
#  Copy to `.env` for local development, or paste into
#  Vercel → Project → Settings → Environment Variables.
# ───────────────────────────────────────────────────────────────

# ── Database ───────────────────────────────────────────────────
# Vercel (production) uses a remote libSQL / Turso database.
# Create one at https://turso.tech and paste its URL + token here.
# When empty, the app falls back to the local file below (development only).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Local SQLite file (only used when TURSO_DATABASE_URL is empty).
DB_PATH=data/school.db

# ── Security ───────────────────────────────────────────────────
# REQUIRED on Vercel. Long random string, e.g. `openssl rand -hex 48`.
# Every change invalidates all existing sessions.
JWT_SECRET=

# ── Google Sign-In (optional) ──────────────────────────────────
# The easiest way is to set these in the app: ការកំណត់ → ព័ត៌មានសាលា.
# Values here override the database settings.
# Authorised redirect URI: <your-domain>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# ── Server ─────────────────────────────────────────────────────
PORT=4173
